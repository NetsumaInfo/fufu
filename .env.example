# ===================================
# DATABASE - Supabase PostgreSQL
# ===================================
# Get these from: https://app.supabase.com/project/_/settings/database
# Connection pooling URL (for Prisma + Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# Direct connection URL (for migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ===================================
# SUPABASE - API Keys
# ===================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# Browser-safe (public) - Can be accessed by anyone
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"

# Server-side only (NEVER expose to client!) - For bypassing RLS
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ===================================
# AUTHENTICATION - JWT Secret
# ===================================
# Generate a random secret: openssl rand -base64 32
JWT_SECRET="your_random_jwt_secret_here_minimum_32_characters"

# ===================================
# EMAIL - Resend (Password Reset)
# ===================================
# Get free API key from: https://resend.com/api-keys (3000 emails/month free)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ===================================
# APPLICATION URL
# ===================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Change to your domain in production

# ===================================
# YOUTUBE API
# ===================================
YOUTUBE_API_KEY="your_youtube_api_key_here"
YOUTUBE_CHANNEL_ID="your_youtube_channel_id_here"

# ===================================
# DISCORD WEBHOOK (Optional)
# ===================================
DISCORD_WEBHOOK_URL="your_discord_webhook_url_here"

# ===================================
# DEPLOYMENT (Optional - for Cloudflare)
# ===================================
# NODE_ENV="production"

